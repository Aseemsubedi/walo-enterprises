# Walo Enterprises — durable static hosting rules (Hostinger)
# Goal: keep the marketing site online even if PHP defaults or leftover app files appear.

Options -Indexes
DirectoryIndex index.html index.php index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical apex without forcing a trailing slash loop
  # Serve static homepage for site root
  RewriteRule ^$ index.html [L]

  # Legacy/broken PHP entrypoints should never take the homepage down
  RewriteRule ^(index|wp-admin|wp-login|xmlrpc)\.php$ /index.html [L,R=302]

  # If a request maps to a missing file/dir, fall back to the static homepage
  # (keeps visitors on-site instead of a blank Hostinger 500)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteRule . /index.html [L]
</IfModule>

# Prefer HTML over PHP when both exist for directory indexes
<IfModule mod_dir.c>
  DirectoryIndex index.html index.php
</IfModule>

# Static assets should never be executed as PHP
<FilesMatch "\.(html?|css|js|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot|map)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
</FilesMatch>

# Friendly fallbacks if Apache error pages are used
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html
ErrorDocument 503 /index.html
